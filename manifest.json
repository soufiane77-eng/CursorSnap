{
  "manifest_version": 3,
  "name": "Cursor Inspector",
  "version": "2.1.0",
  "description": "Détecte l'élément précis sous le curseur, copie un ID court et sauvegarde le JSON complet (sélecteurs, empreinte, contexte DOM) pour une IA.",
  "permissions": ["clipboardWrite", "activeTab", "downloads", "downloads.ui", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cursor Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inspector-core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}